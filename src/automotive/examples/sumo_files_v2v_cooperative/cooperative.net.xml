<?xml version="1.0" encoding="UTF-8"?>

<!--
  Synthetic single-lane straight road, 2000 m, anchored on a real UTM
  zone 32N origin near Turin so that TraCI convertXYtoLonLat() returns
  values inside the ASN.1 Latitude / Longitude ranges
  (±9·10⁸ / ±1.8·10⁹ in 0.1 µdeg). The earlier file used
  projParameter="!" (no projection); convertXYtoLonLat then returned
  raw SUMO metres, which the application multiplied by 1e7 — producing
  longitudes around 3·10⁹ that the UPER encoder rejected, so DENMs
  never made it onto the wire.

  netOffset maps SUMO local (0, 0) onto UTM-zone-32 (394175.96,
  4989734.74), which back-projects to roughly (lat 45.0537°, lon
  7.6624°). The resulting 0.1 µdeg encoding stays well inside the
  ASN.1 constraint.
-->

<net version="0.27" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">

  <location netOffset="-394175.96,-4989734.74"
            convBoundary="0.00,48.40,2000.00,51.40"
            origBoundary="7.6624,45.0537,7.6880,45.0566"
            projParameter="+proj=utm +zone=32 +ellps=WGS84 +datum=WGS84 +units=m +no_defs"/>

  <edge id="E0" from="J0" to="J1" priority="1">
    <lane id="E0_0" index="0" speed="25.00" length="2000.00" shape="0.00,48.40 2000.00,48.40"/>
  </edge>

  <junction id="J0" type="dead_end" x="0.00" y="50.00" incLanes="" intLanes="" shape="0.00,50.00 0.00,46.80"/>
  <junction id="J1" type="dead_end" x="2000.00" y="50.00" incLanes="E0_0" intLanes="" shape="2000.00,46.80 2000.00,50.00"/>

</net>
