<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!--
      Three-car cooperative emergency braking scenario.
      Based on Rolich et al. VTC 2024 / Sidorenko VTC2023-Fall.

      Design intent:
        * Vehicles travel at ~22 m/s (~80 km/h).
        * Leader (veh0) is forced to emergency-stop at a known simulation time
          via TraCI (see v2v-emergencyVehicleAlert-nrv2x.cc and the config keys
          force_brake_time / force_brake_vehicle / force_brake_duration).
          The duration is short enough that the resulting deceleration
          comfortably exceeds the -4 m/s² HardBrakeThreshold.
        * Middle and follower have lower max decel so they cannot match the
          leader's brake. They will hit the 50 m CollisionRiskDistance gate
          and trigger their own DENMs.
        * tau is tight (0.6) so ACC keeps cars close enough that the gap
          gate fires before the followers themselves come to a safe stop.

      Vehicle masses are set per the paper's ethical-harm analysis (heavier
      leader, mid middle, lighter follower). The application currently uses
      a single VehicleMass attribute; we leave the SUMO mass field for future
      per-vehicle mass propagation.
    -->

    <vType id="leader"   accel="3.0" decel="5.0" emergencyDecel="9.0"
           maxSpeed="22"  minGap="2.5" tau="0.6" length="5.0" sigma="0.0"
           mass="2000"    carFollowModel="Krauss" color="1,0,0"/>

    <vType id="middle"   accel="3.0" decel="3.5" emergencyDecel="6.0"
           maxSpeed="22"  minGap="2.5" tau="0.6" length="5.0" sigma="0.0"
           mass="1500"    carFollowModel="Krauss" color="1,1,0"/>

    <vType id="follower" accel="3.0" decel="3.0" emergencyDecel="6.0"
           maxSpeed="22"  minGap="2.5" tau="0.6" length="5.0" sigma="0.0"
           mass="1200"    carFollowModel="Krauss" color="0,0,1"/>

    <!-- Three vehicles in a column. depart durations small enough that
         all three reach steady cruise before the forced brake event. -->
    <vehicle id="veh0" type="leader"   depart="0.00" departSpeed="max">
        <route edges="E0"/>
    </vehicle>

    <vehicle id="veh1" type="middle"   depart="0.50" departSpeed="max">
        <route edges="E0"/>
    </vehicle>

    <vehicle id="veh2" type="follower" depart="1.00" departSpeed="max">
        <route edges="E0"/>
    </vehicle>

</routes>
