<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Отключаем интеллектуальную модель: используем carFollowModel="ACC" -->
    <!-- Устанавливаем постоянную скорость и нулевую дисперсию скорости -->
    <vType id="leader"   accel="10" decel="10" maxSpeed="10" length="5.0"
           carFollowModel="ACC"
           color="1,0,0"/>
    <vType id="middle"   accel="15" decel="1" maxSpeed="30" length="5.0"
           carFollowModel="ACC"
           color="1,1,0"/>
    <vType id="follower" accel="15" decel="1" maxSpeed="30" length="5.0"
           carFollowModel="ACC" 
           color="0,0,1"/>

    <!-- Лидер останавливается на позиции 600 м и стоит 200 секунд -->
    <vehicle id="veh0" type="leader" depart="0.00">
        <route edges="E0"/>
        <stop lane="E0_0" endPos="600" duration="200"/>
    </vehicle>

    <!-- Средний автомобиль выезжает через 0.5 сек, движется со скоростью 20 м/с -->
    <vehicle id="veh1" type="middle" depart="0.50">
        <route edges="E0"/>
    </vehicle>

    <!-- Задний автомобиль выезжает через 1.0 сек, также со скоростью 20 м/с -->
    <vehicle id="veh2" type="follower" depart="1.00">
        <route edges="E0"/>
    </vehicle>

</routes>